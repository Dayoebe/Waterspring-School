APP_NAME="Watersprings International School Akure"
LOGO_PATH="images/watersprings/logo.png"
FAVICON_PATH="images/watersprings/logo.png"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waterspring_school
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# FORCE_HTTPS=true
TRUSTED_PROXIES=
HEALTH_SCHEDULER_GRACE_SECONDS=180
HEALTH_QUEUE_PENDING_WARNING=100
HEALTH_QUEUE_OLDEST_WARNING_SECONDS=900
HEALTH_FAILED_JOBS_WARNING=1

# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
BACKUPS_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_MINIMUM_TABLES=10

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=info@waterspringsschool.com.ng
MAIL_FROM_NAME="${APP_NAME}"

# Paystack payments (keep secret values server-side)
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Use the dedicated webhook signing secret from Paystack when available.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYSTACK_TIMEOUT=15
PAYSTACK_WEBHOOK_TOLERANCE=300

# ClassPilot AI (server-side only)
CLASS_PILOT_ENABLED=true
CLASS_PILOT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
CLASS_PILOT_TIMEOUT=30
CLASS_PILOT_RETRIES=1
CLASS_PILOT_DAILY_REQUESTS=40
CLASS_PILOT_MAX_CONTEXT_CHARACTERS=12000
CLASS_PILOT_RETENTION_DAYS=90
OPEN_LEARNING_SCHOOL_ID=
OPEN_LEARNING_SESSION_LIFETIME=180
OPEN_LEARNING_REQUESTS_PER_MINUTE=8
OPEN_LEARNING_REQUESTS_PER_SESSION=60
OPEN_LEARNING_MAX_MESSAGE_CHARACTERS=1200
OPEN_LEARNING_MAX_HISTORY_MESSAGES=12
